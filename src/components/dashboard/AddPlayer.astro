---
import Icon from '../ui/Icon.astro';
---
<section class="section add-card"><h2><Icon name="add" />Add Player</h2><div class="add-player-form"><label class="sr-only" for="playerNameInput">Player name</label><input type="text" id="playerNameInput" placeholder="Enter player name" maxlength="50" autocomplete="off" aria-describedby="playerNameError"><button id="addPlayerBtn" class="btn btn-primary">Add Player</button></div><p id="playerNameError" class="field-error" role="alert"></p></section>
