---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class="kampo-brand" role="img" aria-label="KAMPO Pickle Ball">
  <img class="brand-stacked" src={base + 'images/kampo-logo-white.svg'} width="1302" height="1025" alt="" />
  <img class="brand-emblem" src={base + 'images/kampo-emblem-white.svg'} width="600" height="672" alt="" />
  <svg class="brand-wordmark" viewBox="0 720 1302 305" aria-hidden="true">
    <image href={base + 'images/kampo-logo-white.svg'} width="1302" height="1025" />
  </svg>
</span>
