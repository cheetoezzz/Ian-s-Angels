---
interface Props { title: string; page?: string; view?: string; }
const { title, page = 'dashboard', view = 'queue' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#82070D" />
    <meta name="description" content="KAMPO Pickle Ball. Fair player rotation, traditional doubles scoring and session rankings, saved on your device." />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href={base + 'manifest.webmanifest'} />
    <link rel="icon" href={base + 'icons/icon-192.png'} />
    <link rel="apple-touch-icon" href={base + 'icons/icon-192.png'} />
    <title>{title} · KAMPO</title>
    <slot name="head" />
  </head>
  <body data-page={page} data-initial-view={view}>
    <slot />
    <script src="../scripts/pwa.ts"></script>
  </body>
</html>
